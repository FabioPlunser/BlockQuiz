{
	"name": "app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"preview": "bun --bun vite preview",
		"prepare": "bun --bun svelte-kit sync || echo ''",
		"copy:blockly-media": "bun --bun run scripts/copy-blockly-media.ts",
		"postinstall": "bun --bun run scripts/copy-blockly-media.ts || echo ''",
		"check": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "bun --bun svelte-kit sync && bun --bun svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "bun --bun prettier --write .",
		"lint": "bun --bun prettier --check . && bun --bun eslint .",
		"test:unit": "bun --bun vitest",
		"test": "bun --bun run test:unit -- --run",
		"test:e2e": "bun --bun playwright test",
		"test:e2e:ui": "bun --bun playwright test --ui",
		"smoke": "bun --bun run scripts/smoke.ts",
		"docker:smoke": "bun --bun run scripts/docker-smoke.ts",
		"db:push": "bun --bun run scripts/db-push.ts",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "npx drizzle-kit migrate",
		"db:studio": "npx drizzle-kit studio",
		"db:seed": "bun --bun run scripts/seed.ts",
		"db:verify": "bun --bun run scripts/verify-db.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@lucia-auth/adapter-drizzle": "^1.1.0",
		"@lucide/svelte": "^1.14.0",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/canvas-confetti": "^1.9.0",
		"@types/dompurify": "^3.2.0",
		"@types/node": "^25.6.2",
		"@types/nodemailer": "^8.0.0",
		"@types/winston": "^2.4.4",
		"@vitest/browser": "^4.1.5",
		"better-auth": "^1.6.10",
		"blockly": "^12.5.1",
		"bun-types": "^1.3.13",
		"daisyui": "^5.5.19",
		"dompurify": "^3.4.2",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"fuse.js": "^7.3.0",
		"globals": "^17.6.0",
		"install": "^0.13.0",
		"mdsvex": "^0.12.7",
		"neverthrow": "^8.2.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"quill": "^2.0.3",
		"runed": "^0.37.1",
		"svelte": "^5.55.5",
		"svelte-adapter-bun": "^1.0.1",
		"svelte-check": "^4.4.8",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12",
		"winston": "^3.19.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@better-auth/sso": "^1.6.10",
		"@iconify/svelte": "^5.2.1",
		"canvas-confetti": "^1.9.4",
		"isomorphic-dompurify": "^3.12.0",
		"nodemailer": "^8.0.7"
	}
}
