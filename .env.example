# Database Configuration
# Format: file:./data/[database_name].db
# Development uses dev.db, production uses prod.db
DATABASE_URL=file:./data/dev.db

# Environment
# Set to 'production' for deployment
NODE_ENV=development

# Optional: Server port (defaults: 3000 for production, 5173 for development)
# PORT=3000

# Optional: Authentication secret (required if using better-auth sessions)
# Generate with: openssl rand -base64 32
# AUTH_SECRET=your-secret-key-here
