# Database Configuration
# Format: file:./data/[database_name].db
# Development uses dev.db, production uses prod.db
DATABASE_URL=file:./data/dev.db

# Environment
# Set to 'production' for deployment
NODE_ENV=development

# Optional: Server port (defaults: 3000 for production, 5173 for development)
# PORT=3000

# Authentication secret. Required in production.
# Generate with: openssl rand -base64 32
# AUTH_SECRET=your-secret-key-here

# Public app URL for Better Auth callbacks and redirects. Required in production.
# Set this to the externally reachable URL, for example: https://example.com
# BETTER_AUTH_URL=http://localhost:5173

# ----------------------------------------------------------------------
# Email transport
# ----------------------------------------------------------------------
# EMAIL_DRIVER=file | smtp | graph   (default: file)
# EMAIL_FROM=BlockQuiz <noreply@your-school.example>
# EMAIL_OUTBOX_DIR=./data/outbox     # only used by the `file` driver

# --- SMTP driver (works for Gmail with an app password) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false                  # true for port 465
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASSWORD=your-16-char-app-password

# --- Microsoft Graph driver (Entra ID) ---
# Register an app in Entra ID with the application permission `Mail.Send`,
# grant admin consent, and create a client secret. GRAPH_FROM_USER must be
# the UPN of a licensed mailbox the app is allowed to send as.
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_FROM_USER=noreply@your-school.onmicrosoft.com

# ----------------------------------------------------------------------
# SSO (OIDC + SAML) — provider records live in the `ssoProvider` table.
# Group/role claim → BlockQuiz role mapping. Comma-separated claim values.
# ----------------------------------------------------------------------
# SSO_ROLE_MAP_TEACHER=Teachers,Lehrer
# SSO_ROLE_MAP_AUTHOR=ContentAuthors
# SSO_ROLE_MAP_ADMIN=BlockQuiz-Admins
